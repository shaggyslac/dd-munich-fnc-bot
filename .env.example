# Lokale Werte für Trockenläufe und Hilfsskripte.
# Im Livebetrieb liegen diese Werte als Cloudflare-Worker-Secrets, nicht hier.
# Niemals die echten Werte committen.

# Green API — aus https://console.green-api.com (Developer-Tarif, kostenlos).
GREENAPI_BASE_URL=https://0000.api.greenapi.com
GREENAPI_ID_INSTANCE=1101000001
GREENAPI_API_TOKEN=abcdef0123456789abcdef0123456789abcdef01

# WhatsApp-Gruppe "potpod" — einmalig mit `pnpm find-group potpod` ermitteln.
WHATSAPP_GROUP_ID=120363000000000000@g.us

# Empfänger für Testnachrichten, damit Tests nie in der Gruppe landen.
TEST_CHAT_ID=430000000000@c.us

# Schützt den HTTP-Endpunkt des Workers (`openssl rand -hex 24`).
WORKER_TEST_TOKEN=

# Ticketpreis in EUR, der das Event als bestätigt markiert (Platzhalter ist 140).
EXPECTED_PRICE_EUR=14

# Optionale Überschreibungen
# EVENT_LIST_URL=https://www.dd-munich.de/event-list
# EVENT_TITLE=Friday Night Commander

# Testschalter — im Livebetrieb nie setzen.
# DRY_RUN=true        # Nachricht nur anzeigen, nicht senden
# IGNORE_WINDOW=true  # Zeitfenster ignorieren
# IGNORE_PRICE=true   # Preisbedingung ignorieren
# TARGET_FRIDAY=2026-10-16  # anderen Freitag prüfen (nur mit DRY_RUN/TEST_MODE)
