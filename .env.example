# Green API credentials — from https://console.green-api.com (Developer plan, free).
# Never commit the real values; in GitHub they live in repository secrets.
GREENAPI_ID_INSTANCE=1101000001
GREENAPI_API_TOKEN=abcdef0123456789abcdef0123456789abcdef01
GREENAPI_BASE_URL=https://api.green-api.com

# WhatsApp group id of "potpod" — determine once via `pnpm find-group potpod`.
WHATSAPP_GROUP_ID=120363000000000000@g.us

# Ticket price in EUR that marks the event as final (the placeholder is 140).
EXPECTED_PRICE_EUR=14

# Optional overrides
# EVENT_LIST_URL=https://www.dd-munich.de/event-list
# EVENT_TITLE=Friday Night Commander

# Test switches — never set these in production.
# DRY_RUN=true        # print the message instead of sending it
# IGNORE_WINDOW=true  # ignore the Wed–Fri time window
# IGNORE_PRICE=true   # ignore the price condition
